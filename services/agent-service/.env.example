# ── HTTP ───────────────────────────────
HOST=0.0.0.0
PORT=8006
SERVICE_VERSION=0.1.0

# CORS 开发白名单（生产由网关统一出口）
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── LLM（P0 决策：先只写配置，不接真实 LLM）──
# mock（默认，无需外部服务）| openai（预留，未接入）
LLM_PROVIDER=mock
# 预留：接入真实 LLM（DeepSeek/Qwen/Ollama 等 OpenAI 兼容接口）时填写
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# 可选：mock 工具调用序列（JSON，P1 测试用），如
# {"trigger":["查找"],"tool_calls":[{"name":"search_nodes","arguments":{"query":"张三"}}]}
MOCK_SCRIPT=

# ── Agent 循环（P1 生效）─────────────
MAX_TOOL_TURNS=8
MAX_OUTPUT_TOKENS=2048

# ── 身份（P1：以用户 JWT 重签调用上游，与 auth-service 同密钥）──
AUTH_SECRET=dev-secret-change-me

# ── 上游服务（P1 工具调用目标）────────
GRAPH_QUERY_URL=http://localhost:8001
IMPORT_SERVICE_URL=http://localhost:8005
INGESTION_URL=http://localhost:8003
