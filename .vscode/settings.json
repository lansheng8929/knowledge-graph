{
  // 全局统一 Python 解释器：不写死平台路径，依赖 VS Code 自动检测仓库根 .venv
  // （macOS 用 .venv/bin/python，Windows 用 .venv\Scripts\python.exe），天然跨平台。
  // 各平台本机执行：python3.12 -m venv .venv && .venv/<bin|Scripts>/python -m pip install <服务依赖>。
  // shared 本地包以 editable 装进根 .venv；系统 Python 是 3.8，无法解析 PEP 604，故必须用 3.12。
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "openFiles",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/shared/service-common",
    "${workspaceFolder}/shared/pep-client",
    "${workspaceFolder}/shared/audit"
  ]
}
